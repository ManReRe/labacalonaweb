# Google Places API (New) — powers the live rating badge on the homepage.
# Both are optional: without them the badge shows the static fallback value
# from src/data/restaurant.ts (used server-side for first paint and JSON-LD).
# Restrict the key by HTTP referrer to this site's domain(s) in Google Cloud
# Console, and restrict it to the Places API (New) only.
PUBLIC_GOOGLE_PLACES_API_KEY=
PUBLIC_GOOGLE_PLACE_ID=
