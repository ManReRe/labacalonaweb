---
import type { MenuSection } from '../data/menu';
import AllergenTags from './AllergenTags.astro';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  sections: MenuSection[];
}

const { locale, sections } = Astro.props;
const strings = t(locale);
---

<div class="space-y-16">
  {sections.map((section) => (
    <section id={section.id} aria-labelledby={`${section.id}-title`} class="scroll-mt-24">
      <div class="flex items-center gap-4">
        <span aria-hidden="true" class="diamond h-2.5 w-2.5 shrink-0 bg-olive-dark"></span>
        <h2 id={`${section.id}-title`} class="font-display text-3xl text-ink">
          {section.title[locale]}
        </h2>
        <span aria-hidden="true" class="h-px flex-1 bg-ink/15"></span>
      </div>
      {section.subtitle && <p class="mt-2 pl-[26px] italic text-ink-soft">{section.subtitle[locale]}</p>}

      <ul class="mt-6 divide-y divide-ink/10">
        {section.dishes.map((dish) => {
          const singlePrice = dish.prices.length === 1 && !dish.prices[0].label;
          return (
            <li class="py-4">
              {singlePrice ? (
                <div class="flex items-baseline gap-1">
                  <p class="font-semibold text-ink">{dish.name}</p>
                  <span aria-hidden="true" class="price-leader"></span>
                  <span class="font-semibold text-ink">{dish.prices[0].price}</span>
                </div>
              ) : (
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                  <p class="font-semibold text-ink sm:max-w-xl">{dish.name}</p>
                  <div class="flex shrink-0 gap-4 text-right sm:flex-col sm:items-end sm:gap-0.5">
                    {dish.prices.map((p) => (
                      <p class="whitespace-nowrap text-ink">
                        {p.label && <span class="mr-1 text-xs uppercase tracking-wide text-ink-soft">{p.label[locale]}</span>}
                        <span class="font-semibold">{p.price}</span>
                      </p>
                    ))}
                  </div>
                </div>
              )}
              {dish.description && <p class="mt-1 text-sm text-ink-soft sm:max-w-xl">{dish.description[locale]}</p>}
              <AllergenTags locale={locale} codes={dish.allergens} />
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>
