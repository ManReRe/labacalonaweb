---
// Google rating + review count. Renders the last manually-checked value from
// restaurant.ts server-side (first paint, no-JS, and JSON-LD all use that),
// then a client script silently refreshes it from the Places API (New) on
// each visit when PUBLIC_GOOGLE_PLACES_API_KEY/PLACE_ID are configured — see
// .env.example. No link to the reviews themselves, per the client's request.
import StarRating from './StarRating.astro';
import { restaurant } from '../data/restaurant';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const { value, count } = restaurant.googleRating;
const displayValue = locale === 'es' ? value.toString().replace('.', ',') : value.toString();
---

<div class="inline-flex items-center gap-2 text-ink-soft" data-google-rating>
  <StarRating value={value} emptyClass="text-ink/15" filledClass="text-olive-dark" />
  <span class="font-semibold text-ink" data-rating-value>{displayValue}</span>
  <span>· <span data-rating-count>{count}</span> {strings.googleReviews.suffix}</span>
</div>

<script>
  const PLACE_ID = import.meta.env.PUBLIC_GOOGLE_PLACE_ID;
  const API_KEY = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY;

  async function refreshGoogleRating() {
    if (!PLACE_ID || !API_KEY) return;

    const badge = document.querySelector('[data-google-rating]');
    if (!badge) return;

    let data;
    try {
      const res = await fetch(`https://places.googleapis.com/v1/places/${PLACE_ID}`, {
        headers: {
          'X-Goog-Api-Key': API_KEY,
          'X-Goog-FieldMask': 'rating,userRatingCount',
        },
      });
      if (!res.ok) return;
      data = await res.json();
    } catch {
      // Offline or the API call failed: keep the static fallback already rendered.
      return;
    }

    if (typeof data.rating !== 'number' || typeof data.userRatingCount !== 'number') return;

    const fill = badge.querySelector('[data-star-fill]');
    if (fill instanceof HTMLElement) {
      fill.style.width = `${Math.max(0, Math.min(100, (data.rating / 5) * 100))}%`;
    }

    const valueEl = badge.querySelector('[data-rating-value]');
    if (valueEl) {
      const isSpanish = document.documentElement.lang === 'es';
      valueEl.textContent = isSpanish ? data.rating.toString().replace('.', ',') : data.rating.toString();
    }

    const countEl = badge.querySelector('[data-rating-count]');
    if (countEl) countEl.textContent = String(data.userRatingCount);
  }

  refreshGoogleRating();
</script>
