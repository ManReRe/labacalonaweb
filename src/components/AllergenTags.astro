---
import { allergens, type AllergenCode } from '../data/allergens';
import { t, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  codes: AllergenCode[];
}

const { locale, codes } = Astro.props;
const strings = t(locale);
---

{codes.length > 0 && (
  <ul class="mt-2 flex flex-wrap gap-1.5" aria-label={`${strings.allergens.contains}: ${codes.map((c) => allergens[c][locale]).join(', ')}`}>
    {codes.map((code) => (
      <li
        class="inline-flex h-6 min-w-6 items-center justify-center rounded-full border border-ink/10 bg-sand/70 px-1 text-xs leading-none"
        title={allergens[code][locale]}
        aria-hidden="true"
      >
        {allergens[code].icon}
      </li>
    ))}
  </ul>
)}
