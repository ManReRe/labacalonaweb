---
import { restaurant } from '../data/restaurant';
import { routes, t, type Locale } from '../data/i18n';
import { withBase } from '../utils/paths';

interface Props {
  locale: Locale;
  /** Set true when placed on a dark section (e.g. the espresso hero) so the
   * outline "call us" button stays readable instead of dark-on-dark. */
  onDark?: boolean;
}

const { locale, onDark = false } = Astro.props;
const strings = t(locale);

const secondaryClasses = onDark
  ? 'border-cream-white/40 text-cream-white hover:bg-cream-white hover:text-ink'
  : 'border-ink/30 text-ink hover:bg-ink hover:text-cream-white';
---

<div class="flex flex-col gap-3 sm:flex-row">
  <a
    href={`${withBase(routes.reservations[locale])}#reservar`}
    class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-olive px-6 py-3 font-semibold text-cream-white shadow-sm transition-colors hover:bg-olive-dark"
  >
    {strings.cta.reserveOnline}
  </a>
  <a
    href={`tel:+34${restaurant.phone}`}
    class:list={[
      'inline-flex min-h-[44px] items-center justify-center gap-1 rounded-md border px-6 py-3 font-semibold transition-colors',
      secondaryClasses,
    ]}
  >
    {strings.cta.callUs}
  </a>
</div>
