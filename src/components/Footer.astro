---
import { restaurant } from '../data/restaurant';
import { routes, t, type Locale } from '../data/i18n';
import { withBase } from '../utils/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-ink/10 bg-espresso text-cream-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div>
      <p class="font-display text-2xl tracking-wide">{restaurant.name}</p>
      <p class="mt-2 text-sm text-cream-white/80">{strings.footer.tagline}</p>
      <a
        href={restaurant.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex min-h-[44px] items-center gap-2 text-sm font-medium underline-offset-4 hover:underline"
      >
        {strings.footer.followUs} · Instagram
      </a>
    </div>

    <div>
      <p class="font-semibold">{strings.address}</p>
      <address class="mt-2 not-italic text-sm text-cream-white/80">
        {restaurant.address.streetAddress}<br />
        {restaurant.address.postalCode} {restaurant.address.addressLocality}
      </address>
      <p class="mt-3 font-semibold">{strings.phone}</p>
      <a href={`tel:+34${restaurant.phone}`} class="text-sm text-cream-white/80 hover:underline">
        {restaurant.phoneDisplay}
      </a>
      <p class="mt-3 font-semibold">{strings.hours}</p>
      <p class="text-sm text-cream-white/80">{restaurant.openingHours.display[locale]}</p>
    </div>

    <div>
      <p class="font-semibold">{strings.footer.linksTitle}</p>
      <ul class="mt-2 space-y-2 text-sm text-cream-white/80">
        <li><a class="hover:underline" href={withBase(routes.home[locale])}>{strings.nav.home}</a></li>
        <li><a class="hover:underline" href={withBase(routes.menu[locale])}>{strings.nav.menu}</a></li>
        <li><a class="hover:underline" href={withBase(routes.wines[locale])}>{strings.nav.wines}</a></li>
        <li><a class="hover:underline" href={withBase(routes.reservations[locale])}>{strings.nav.reservations}</a></li>
        <li><a class="hover:underline" href={withBase(routes.about[locale])}>{strings.nav.about}</a></li>
        <li><a class="hover:underline" href={withBase(routes.contact[locale])}>{strings.nav.contact}</a></li>
      </ul>
    </div>

    <div>
      <p class="font-semibold">{strings.footer.legalTitle}</p>
      <ul class="mt-2 space-y-2 text-sm text-cream-white/80">
        <li><a class="hover:underline" href={withBase(routes.legalNotice[locale])}>{strings.footer.legalNotice}</a></li>
        <li><a class="hover:underline" href={withBase(routes.privacy[locale])}>{strings.footer.privacy}</a></li>
        <li><a class="hover:underline" href={withBase(routes.cookies[locale])}>{strings.footer.cookies}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream-white/10 px-4 py-4 text-center text-xs text-cream-white/60 sm:px-6">
    &copy; {year} {restaurant.legalName}. {strings.footer.rights}
  </div>
</footer>
