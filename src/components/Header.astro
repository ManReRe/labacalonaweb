---
import { Image } from 'astro:assets';
import { restaurant } from '../data/restaurant';
import { routes, t, otherLocale, type Locale, type RouteKey } from '../data/i18n';
import { withBase } from '../utils/paths';
import logoHeader from '../assets/images/logo-header.png';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const strings = t(locale);
const other = otherLocale(locale);

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'home', label: strings.nav.home },
  { key: 'about', label: strings.nav.about },
  { key: 'menu', label: strings.nav.menu },
  { key: 'wines', label: strings.nav.wines },
  { key: 'reservations', label: strings.nav.reservations },
  { key: 'contact', label: strings.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex min-h-[64px] max-w-6xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <a href={withBase(routes.home[locale])} class="flex shrink-0 items-center">
      <Image src={logoHeader} alt={restaurant.name} class="h-5 w-auto sm:h-6" />
    </a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded lg:hidden"
      aria-label={strings.nav.home}
    >
      <span class="sr-only">Menú</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <nav
      class="fixed inset-x-0 top-[64px] hidden max-h-[calc(100vh-64px)] flex-col gap-1 overflow-y-auto bg-paper px-4 py-4 shadow-lg peer-checked:flex lg:static lg:flex lg:max-h-none lg:flex-row lg:items-center lg:gap-6 lg:overflow-visible lg:bg-transparent lg:p-0 lg:shadow-none"
      aria-label="Main"
    >
      <div class="flex flex-col gap-1 lg:flex-row lg:items-center lg:gap-6">
        {navItems.map((item) => (
          <a
            href={withBase(routes[item.key][locale])}
            class:list={[
              'relative min-h-[44px] whitespace-nowrap py-2.5 font-medium tracking-wide hover:text-olive-dark lg:min-h-0 lg:py-1',
              routeKey === item.key ? 'text-olive-dark' : 'text-ink',
            ]}
            aria-current={routeKey === item.key ? 'page' : undefined}
          >
            {item.label}
            {routeKey === item.key && (
              <span aria-hidden="true" class="diamond absolute -bottom-1.5 left-0 hidden h-1.5 w-1.5 bg-olive-dark lg:inline-block"></span>
            )}
          </a>
        ))}
      </div>

      <div class="mt-2 flex items-center gap-3 border-t border-ink/10 pt-3 lg:ml-2 lg:mt-0 lg:border-0 lg:pt-0">
        <a
          href={withBase(routes[routeKey][other])}
          hreflang={other}
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-ink/20 px-3 py-1.5 text-sm font-semibold tracking-wide text-ink hover:border-ink/40 hover:bg-ink/5 lg:min-h-0"
          aria-label={strings.languageSwitcher}
        >
          {other.toUpperCase()}
        </a>
        <a
          href={withBase(routes.reservations[locale])}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-olive px-5 py-2.5 font-semibold text-cream-white shadow-sm transition-colors hover:bg-olive-dark"
        >
          {strings.cta.reserve}
        </a>
      </div>
    </nav>
  </div>
</header>
