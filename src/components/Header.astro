---
import { restaurant } from '../data/restaurant';
import { routes, t, otherLocale, type Locale, type RouteKey } from '../data/i18n';
import { withBase } from '../utils/paths';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const strings = t(locale);
const other = otherLocale(locale);

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'home', label: strings.nav.home },
  { key: 'about', label: strings.nav.about },
  { key: 'menu', label: strings.nav.menu },
  { key: 'wines', label: strings.nav.wines },
  { key: 'reservations', label: strings.nav.reservations },
  { key: 'contact', label: strings.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex h-[68px] max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={withBase(routes.home[locale])} class="flex items-center gap-2.5 font-display text-2xl leading-none text-ink">
      <span aria-hidden="true" class="diamond h-3.5 w-3.5 shrink-0 bg-ink"></span>
      <span class="pt-0.5">{restaurant.name}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />
    <label
      for="nav-toggle"
      class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded md:hidden"
      aria-label={strings.nav.home}
    >
      <span class="sr-only">Menú</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <nav
      class="fixed inset-x-0 top-[68px] hidden max-h-[calc(100vh-68px)] flex-col gap-1 overflow-y-auto bg-paper px-4 py-4 shadow-lg peer-checked:flex md:static md:flex md:max-h-none md:flex-row md:items-center md:gap-8 md:overflow-visible md:bg-transparent md:p-0 md:shadow-none"
      aria-label="Main"
    >
      <div class="flex flex-col gap-1 md:flex-row md:items-center md:gap-8">
        {navItems.map((item) => (
          <a
            href={withBase(routes[item.key][locale])}
            class:list={[
              'relative min-h-[44px] py-2.5 font-medium tracking-wide hover:text-olive-dark md:min-h-0 md:py-1',
              routeKey === item.key ? 'text-olive-dark' : 'text-ink',
            ]}
            aria-current={routeKey === item.key ? 'page' : undefined}
          >
            {item.label}
            {routeKey === item.key && (
              <span aria-hidden="true" class="diamond absolute -bottom-1.5 left-0 hidden h-1.5 w-1.5 bg-olive-dark md:inline-block"></span>
            )}
          </a>
        ))}
      </div>

      <div class="mt-2 flex items-center gap-3 border-t border-ink/10 pt-3 md:ml-2 md:mt-0 md:border-0 md:pt-0">
        <a
          href={withBase(routes[routeKey][other])}
          hreflang={other}
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-ink/20 px-3 py-1.5 text-sm font-semibold tracking-wide text-ink hover:border-ink/40 hover:bg-ink/5 md:min-h-0"
          aria-label={strings.languageSwitcher}
        >
          {other.toUpperCase()}
        </a>
        <a
          href={withBase(routes.reservations[locale])}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-olive px-5 py-2.5 font-semibold text-cream-white shadow-sm transition-colors hover:bg-olive-dark"
        >
          {strings.cta.reserve}
        </a>
      </div>
    </nav>
  </div>
</header>
