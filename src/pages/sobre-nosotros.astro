---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ReservationCta from '../components/ReservationCta.astro';
import interiorImg from '../assets/images/pro-decor-panes.jpg';

const locale = 'es' as const;
---

<Layout
  locale={locale}
  routeKey="about"
  title="Sobre nosotros | La Bacalona - Restaurante en Sevilla"
  description="Conoce La Bacalona: una taberna extremeña-andaluza nacida del cariño por el producto de temporada, los ibéricos de bellota y el barrio que nos rodea."
>
  <PageHero eyebrow="Sobre nosotros" title="Nuestra historia" />

  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 md:items-center">
    <div class="space-y-5 text-ink-soft">
      <p>
        La Bacalona nace como una taberna en el corazón de Sevilla, un lugar donde comer y beber bien no está
        reñido con la cercanía. Recuperamos el espíritu de las tabernas extremeñas (de chacinas, quesos, y carnes
        de bellota combinadas con una oferta gastronómica tradicional y creativa) y lo servimos con la calidez
        propia de una taberna sevillana de barrio.
      </p>
      <p>
        Nuestra cocina se apoya en el producto de temporada y en los ibéricos de bellota, con guiños a la
        tradición andaluza, la cocina extremeña y demás gama de platos tanto combinando ambas como de propuesta
        propia. No buscamos complicar: buscamos que cada plato sepa exactamente a lo que es.
      </p>
      <p>
        Creemos en la mesa compartida, en las raciones que invitan a probar de todo y en un servicio cercano que
        te hace sentir en casa, aunque estés a pie de calle en pleno centro de Sevilla.
      </p>
    </div>
    <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
      <Image
        src={interiorImg}
        alt="Comedor de La Bacalona en Sevilla"
        width={640}
        height={640}
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <div class="mx-auto flex max-w-4xl justify-center px-4 pb-16 sm:px-6">
    <ReservationCta locale={locale} />
  </div>
</Layout>
