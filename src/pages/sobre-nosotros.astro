---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ReservationCta from '../components/ReservationCta.astro';
import interiorImg from '../assets/images/pro-decor-panes.jpg';

const locale = 'es' as const;
---

<Layout
  locale={locale}
  routeKey="about"
  title="Sobre nosotros | La Bacalona - Restaurante en Sevilla"
  description="Conoce La Bacalona: taberna extremeña desde 2022 en el centro de Sevilla, con producto de Llerena, Fregenal y buena carta de vinos."
>
  <PageHero eyebrow="Sobre nosotros" title="Nuestra historia" />

  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 md:items-center">
    <div class="space-y-5 text-ink-soft">
      <p>
        La Bacalona nace en 2022 como una taberna en la calle Amador de los Ríos, en pleno centro de Sevilla.
        Recuperamos el espíritu de las tabernas extremeñas —chacinas, quesos y carnes de bellota— y lo servimos
        con la calidez de una taberna de barrio.
      </p>
      <p>
        En cocina trabaja un equipo de profesionales que cuida el producto: chacinas de Llerena, carnes ibéricas
        de bellota de Fregenal de la Sierra, quesos de distintas zonas de Extremadura, atún de Petaca Chico,
        Torta del Casar y patatera extremeña.
      </p>
      <p>
        Creemos en la mesa compartida: raciones para probar de todo, platos propios como el flamenquín o el
        cachopazo Bacalona, y sitio de sobra en el salón y la terraza para grupos de hasta 150 personas. Contamos
        con aseo adaptado para personas con movilidad reducida.
      </p>
    </div>
    <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
      <Image
        src={interiorImg}
        alt="Comedor de La Bacalona en Sevilla"
        width={640}
        height={640}
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <div class="mx-auto flex max-w-4xl justify-center px-4 pb-16 sm:px-6">
    <ReservationCta locale={locale} />
  </div>
</Layout>
