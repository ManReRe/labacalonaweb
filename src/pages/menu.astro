---
import Layout from '../layouts/Layout.astro';
import DishList from '../components/DishList.astro';
import AllergenLegend from '../components/AllergenLegend.astro';
import PageHero from '../components/PageHero.astro';
import ReservationCta from '../components/ReservationCta.astro';
import { menuSections, menuNotes, buildMenuJsonLd } from '../data/menu';
import { routes } from '../data/i18n';
import { withBase } from '../utils/paths';

const locale = 'es' as const;
const menuJsonLd = buildMenuJsonLd(locale);
---

<Layout
  locale={locale}
  routeKey="menu"
  title="Carta | La Bacalona - Restaurante en Sevilla"
  description="Descubre la carta de La Bacalona: entrantes, ibéricos, guisos, platos a la plancha y postres caseros, con alérgenos indicados en cada plato."
>
  <script type="application/ld+json" set:html={JSON.stringify(menuJsonLd)} is:inline />

  <PageHero eyebrow="Carta" title="Nuestra carta">
    <ReservationCta locale={locale} />
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <DishList locale={locale} sections={menuSections} />

    <ul class="mt-10 space-y-1 text-sm text-ink-soft">
      {menuNotes.es.map((note) => <li>{note}</li>)}
    </ul>

    <AllergenLegend locale={locale} />

    <p class="mt-6 text-center text-ink-soft">
      ¿Quieres maridarlo? Echa un vistazo a{' '}
      <a href={withBase(routes.wines[locale])} class="font-semibold text-olive-dark underline-offset-4 hover:underline">
        nuestra carta de vinos
      </a>.
    </p>

    <div class="mt-6 flex justify-center">
      <ReservationCta locale={locale} />
    </div>
  </div>
</Layout>
