---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ReservationCta from '../components/ReservationCta.astro';
import { routes, t } from '../data/i18n';
import { restaurant } from '../data/restaurant';
import { withBase } from '../utils/paths';
import DiamondIcon from '../components/DiamondIcon.astro';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import logoWhite from '../assets/images/logo-header-white.png';
import heroBgImg from '../assets/images/pro-hero-bg.jpg';
import jamonImg from '../assets/images/pro-jamon.jpg';
import platoImg from '../assets/images/pro-plato-tapa.jpg';
import vinosImg from '../assets/images/pro-vinos.jpg';
import mesaLargaImg from '../assets/images/pro-mesa-larga.jpg';

const locale = 'es' as const;
const strings = t(locale);

// Four cards, each with a concrete, specific fact (2026-10-20 rewrite) — cut
// from six after the previous set leaned on generic filler ("magnífico
// ambiente familiar", "trato cercano") with nothing behind it.
const highlights = [
  {
    title: 'Chacinas de Llerena, carnes ibéricas de Fregenal.',
    text: 'Trabajamos con proveedores extremeños y andaluces de siempre: chacinas de Llerena, quesos de varias zonas de Extremadura y carnes ibéricas de bellota de Fregenal de la Sierra.',
    img: jamonImg,
    alt: 'Chacinas y jamón ibérico cortados a mano',
  },
  {
    title: 'Vino de nuestra bodega, Palacio Quemado.',
    text: 'Está en Alange (Badajoz), D.O. Ribera del Guadiana. La completamos con tintos de Ribera del Duero y Rioja, blancos D.O. Rueda y generosos, por copa o botella.',
    img: vinosImg,
    alt: 'Copa de vino tinto Palacio Quemado',
  },
  {
    title: 'El flamenquín y el cachopazo no suelen sobrar.',
    text: 'Taco de chicharrón, tartar de atún, carpaccio de panceta de bellota, cachopazo Bacalona para compartir... y el flamenquín, que casi nadie deja en el plato.',
    img: platoImg,
    alt: 'Flamenquín Bacalona recién hecho',
  },
  {
    title: 'Salón y terraza para grupos de hasta 150.',
    text: 'Distintas configuraciones de mesa según cuántos seáis, evento privado con el local completo o parcial, y menús de grupo a medida.',
    img: mesaLargaImg,
    alt: 'Mesa larga preparada para un grupo',
  },
];
---

<Layout
  locale={locale}
  routeKey="home"
  title="La Bacalona Sevilla"
  description="Taberna extremeña en Sevilla desde 2022: chacinas de Llerena, ibéricos de bellota de Fregenal y vino de Alange. Reserva mesa online."
>
  <section class="relative overflow-hidden bg-espresso text-cream-white">
    <Image
      src={heroBgImg}
      alt=""
      widths={[480, 768, 1024, 1600, 2000]}
      sizes="100vw"
      width={2000}
      height={1150}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-[65%_50%]"
    />
    <div class="absolute inset-0 bg-espresso/80"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 md:py-28">
      <h1>
        <Image src={logoWhite} alt={restaurant.name} width={480} height={56} loading="eager" fetchpriority="high" class="mx-auto h-auto w-full max-w-md" />
      </h1>
      <div class="mt-9 flex justify-center">
        <ReservationCta locale={locale} onDark />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="space-y-16 sm:space-y-24">
      {highlights.map((item, i) => (
        <div
          data-reveal
          class:list={[
            'grid items-center gap-8 sm:grid-cols-2 sm:gap-12',
            i % 2 === 1 && 'sm:[&>*:first-child]:order-2',
          ]}
        >
          <div class="overflow-hidden rounded-lg shadow-md">
            <Image
              src={item.img}
              alt={item.alt}
              width={700}
              height={500}
              class="aspect-[7/5] w-full object-cover"
            />
          </div>
          <div>
            <p class="font-display text-3xl leading-tight text-ink sm:text-4xl">{item.title}</p>
            <p class="mt-4 text-lg text-ink-soft">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-16 flex flex-wrap justify-center gap-4">
      <a href={withBase(routes.menu[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-olive px-6 py-3 font-semibold text-cream-white shadow-sm hover:bg-olive-dark">
        {strings.cta.seeMenu}
      </a>
      <a href={withBase(routes.wines[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-ink/30 px-6 py-3 font-semibold text-ink hover:bg-ink hover:text-cream-white">
        {strings.cta.seeWines}
      </a>
    </div>
  </section>

  <section class="bg-sand/50 py-20">
    <div data-reveal class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <DiamondIcon class="mx-auto mb-4 block h-3.5 w-3.5 text-olive" />
      <h2 class="font-display text-4xl text-ink">En el corazón de Sevilla</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-soft">
        Estamos en la calle Amador de los Ríos. Abrimos en 2022 para traer el producto extremeño a una taberna de
        barrio, con salón amplio y terraza para grupos.
      </p>
      <div class="mt-6">
        <a href={withBase(routes.about[locale])} class="inline-block font-semibold text-olive-dark underline-offset-4 hover:underline">
          Conoce nuestra historia
        </a>
      </div>
      <div class="mt-4">
        <GoogleRatingBadge locale={locale} />
      </div>
    </div>
  </section>
</Layout>
