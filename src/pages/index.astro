---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ReservationCta from '../components/ReservationCta.astro';
import { routes, t } from '../data/i18n';
import { restaurant } from '../data/restaurant';
import { withBase } from '../utils/paths';
import DiamondIcon from '../components/DiamondIcon.astro';
import StarRating from '../components/StarRating.astro';
import interiorImg from '../assets/images/interior-1.jpg';
import logoWhite from '../assets/images/logo-header-white.png';
import huevosImg from '../assets/images/dish-huevos-fritas.jpg';
import boqueronesImg from '../assets/images/dish-boquerones.jpg';
import tacoImg from '../assets/images/dish-taco.jpg';

const locale = 'es' as const;
const strings = t(locale);

// Placeholder photos, repeated — real dedicated shots come later (site not public yet).
const highlights = [
  { text: 'Producto extremeño de primera calidad.', img: huevosImg },
  { text: 'Cocina tradicional e innovación.', img: tacoImg },
  { text: 'Bodega de vinos extremeños y andaluces.', img: boqueronesImg },
  { text: 'Magnífico ambiente familiar.', img: interiorImg },
  { text: 'Celebración de reuniones y de eventos.', img: interiorImg },
  { text: 'Trato cercano y familiar.', img: huevosImg },
];
---

<Layout
  locale={locale}
  routeKey="home"
  isHome
  title="La Bacalona Sevilla"
  description="La Bacalona: taberna extremeña-andaluza con producto de temporada, ibéricos de bellota y una carta pensada para compartir. Reserva mesa en Sevilla."
>
  <section class="bg-espresso text-cream-white">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 md:py-28">
      <h1>
        <Image src={logoWhite} alt={restaurant.name} width={480} height={56} class="mx-auto h-auto w-full max-w-md" />
      </h1>
      <div class="mt-9 flex justify-center">
        <ReservationCta locale={locale} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="text-center">
      <h2 class="font-display text-4xl text-ink">Lo que nos define</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-soft">{restaurant.shortDescription.es}</p>
    </div>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {highlights.map((item) => (
        <li class="overflow-hidden rounded-lg border border-ink/10 bg-cream-white shadow-sm">
          <Image src={item.img} alt="" width={480} height={320} class="h-40 w-full object-cover" />
          <p class="p-4 font-medium text-ink">{item.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={withBase(routes.menu[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-olive px-6 py-3 font-semibold text-cream-white shadow-sm hover:bg-olive-dark">
        {strings.cta.seeMenu}
      </a>
      <a href={withBase(routes.wines[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-ink/30 px-6 py-3 font-semibold text-ink hover:bg-ink hover:text-cream-white">
        {strings.cta.seeWines}
      </a>
    </div>
  </section>

  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <DiamondIcon class="mx-auto mb-4 block h-3.5 w-3.5 text-olive" />
      <h2 class="font-display text-4xl text-ink">En el corazón de Sevilla</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-soft">
        Nos encontrarás en la calle Amador de los Ríos, en el corazón de Sevilla. Un lugar donde el buen gusto, el
        producto ibérico, la creación y la cocina honesta son los protagonistas. Además de un ambiente amplio y
        familiar que invita a disfrutar de La Bacalona en cualquier momento del día.
      </p>
      <a href={withBase(routes.about[locale])} class="mt-6 inline-block font-semibold text-olive-dark underline-offset-4 hover:underline">
        Conoce nuestra historia →
      </a>
      <div class="mt-6 inline-flex items-center gap-2 text-ink-soft">
        <StarRating value={restaurant.googleRating.value} emptyClass="text-ink/15" filledClass="text-olive-dark" />
        <span class="font-semibold text-ink">{restaurant.googleRating.value.toString().replace('.', ',')}</span>
        <span>· {restaurant.googleRating.count} reseñas en Google</span>
      </div>
    </div>
  </section>
</Layout>
