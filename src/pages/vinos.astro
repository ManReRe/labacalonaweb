---
import Layout from '../layouts/Layout.astro';
import WineList from '../components/WineList.astro';
import AllergenLegend from '../components/AllergenLegend.astro';
import PageHero from '../components/PageHero.astro';
import ReservationCta from '../components/ReservationCta.astro';
import { wineSections } from '../data/wines';

const locale = 'es' as const;
---

<Layout
  locale={locale}
  routeKey="wines"
  title="Vinos | La Bacalona - Restaurante en Sevilla"
  description="Carta de vinos de La Bacalona: Palacio Quemado (Alange) como bodega de la casa, más tintos de Ribera del Duero y Rioja, blancos y generosos."
>
  <PageHero
    eyebrow="Vinos"
    title="Nuestra carta de vinos"
    subtitle="Nuestra bodega de la casa es Palacio Quemado, en Alange (Badajoz). La tienes por copa o botella, junto a tintos de Ribera del Duero y Rioja, blancos y generosos."
  >
    <ReservationCta locale={locale} />
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <WineList locale={locale} sections={wineSections} />

    <AllergenLegend locale={locale} />

    <div class="mt-10 flex justify-center">
      <ReservationCta locale={locale} />
    </div>
  </div>
</Layout>
