---
import Layout from '../layouts/Layout.astro';
import WineList from '../components/WineList.astro';
import AllergenLegend from '../components/AllergenLegend.astro';
import PageHero from '../components/PageHero.astro';
import ReservationCta from '../components/ReservationCta.astro';
import { wineSections } from '../data/wines';
import { routes } from '../data/i18n';
import { withBase } from '../utils/paths';

const locale = 'es' as const;
---

<Layout
  locale={locale}
  routeKey="wines"
  title="Vinos | La Bacalona - Restaurante en Sevilla"
  description="Carta de vinos de La Bacalona: tintos de Ribera del Duero, Rioja y Ribera del Guadiana, blancos D.O. Rueda y generosos, por copa o botella."
>
  <PageHero
    eyebrow="Vinos"
    title="Nuestra carta de vinos"
    subtitle="Tintos de Ribera del Duero, Rioja y Ribera del Guadiana, blancos D.O. Rueda y generosos — por copa o botella."
  >
    <ReservationCta locale={locale} />
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <WineList locale={locale} sections={wineSections} />

    <AllergenLegend locale={locale} />

    <p class="mt-6 text-center text-ink-soft">
      ¿Prefieres ver primero qué comer? Aquí tienes{' '}
      <a href={withBase(routes.menu[locale])} class="font-semibold text-olive-dark underline-offset-4 hover:underline">
        nuestra carta
      </a>.
    </p>

    <div class="mt-6 flex justify-center">
      <ReservationCta locale={locale} />
    </div>
  </div>
</Layout>
