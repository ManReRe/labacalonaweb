---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CoverManagerWidget from '../../components/CoverManagerWidget.astro';
import DiamondIcon from '../../components/DiamondIcon.astro';
import { restaurant } from '../../data/restaurant';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  routeKey="reservations"
  title="Reservations | La Bacalona - Restaurant in Seville"
  description="Book a table at La Bacalona online, right on this page, or by phone at +34 683 37 33 39."
>
  <PageHero eyebrow="Reservations" title="Book your table" subtitle="Choose your date, time, and party size right here. Instant confirmation." />

  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="flex items-start gap-4 rounded-lg border border-ink/10 bg-cream-white p-5">
      <DiamondIcon class="mt-0.5 h-3.5 w-3.5 shrink-0 text-olive" />
      <p class="text-ink-soft">
        Prefer to talk to us?{' '}
        <a class="font-semibold text-ink underline underline-offset-4 hover:text-olive-dark" href={`tel:+34${restaurant.phone}`}>Call us</a>{' '}
        whenever suits you. If you'd like to organise a private event or need a table for a large group, we'll
        be happy to help.
      </p>
    </div>

    <div class="mt-8">
      <CoverManagerWidget locale={locale} />
    </div>

    <p class="mt-8 text-center text-ink-soft">Open every day, with continuous service:</p>
    <p class="mt-1 whitespace-pre-line text-center font-semibold text-ink">
      {restaurant.openingHours.display.en}
    </p>
  </div>
</Layout>
