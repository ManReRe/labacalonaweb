---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import { restaurant } from '../../data/restaurant';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  routeKey="reservations"
  title="Reservations | La Bacalona — Restaurant in Seville"
  description="Book a table at La Bacalona: online via CoverManager or by phone at +34 683 37 33 39. Open every day from 12:30 PM to 12:30 AM."
>
  <PageHero eyebrow="Reservations" title="Book your table" />

  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="rounded-lg border border-ink/10 bg-cream-white p-6 sm:p-8">
      <h2 class="font-display text-2xl tracking-wide text-ink">Two ways to book</h2>
      <ol class="mt-4 space-y-4 text-ink-soft">
        <li>
          <p class="font-semibold text-ink">1. Online, via CoverManager</p>
          <p>Choose your date, time, and party size through our booking system. Instant confirmation.</p>
        </li>
        <li>
          <p class="font-semibold text-ink">2. By phone</p>
          <p>
            Call us at <a class="underline underline-offset-4 hover:text-olive-dark" href={`tel:+34${restaurant.phone}`}>+34 {restaurant.phoneDisplay}</a>
            and we'll help you find the best time, including for groups and events.
          </p>
        </li>
      </ol>

      <div class="mt-8">
        <ReservationCta locale={locale} />
      </div>
    </div>

    <p class="mt-8 text-center text-ink-soft">
      Open every day from <strong class="text-ink">12:30 PM to 12:30 AM</strong>, with continuous service.
    </p>
  </div>
</Layout>
