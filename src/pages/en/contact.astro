---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { restaurant } from '../../data/restaurant';
import { t } from '../../data/i18n';

const locale = 'en' as const;
const strings = t(locale);
---

<Layout
  locale={locale}
  routeKey="contact"
  title="Contact | La Bacalona — Restaurant in Seville"
  description="Find La Bacalona at C. Amador de los Ríos, 38, Seville. Phone number, opening hours, and directions to the restaurant."
>
  <PageHero eyebrow="Contact" title="Find us" />

  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="font-display text-2xl tracking-wide text-ink">{strings.address}</h2>
      <address class="mt-2 not-italic text-ink-soft">
        {restaurant.address.streetAddress}<br />
        {restaurant.address.postalCode} {restaurant.address.addressLocality}, Spain
      </address>
      <p class="mt-2 text-ink-soft">
        A short walk from the Museum of Fine Arts and the Alameda de Hércules, in Seville's historic city centre.
      </p>

      <h2 class="mt-8 font-display text-2xl tracking-wide text-ink">{strings.phone}</h2>
      <a href={`tel:+34${restaurant.phone}`} class="mt-2 block text-ink-soft underline-offset-4 hover:underline">
        +34 {restaurant.phoneDisplay}
      </a>

      <h2 class="mt-8 font-display text-2xl tracking-wide text-ink">{strings.hours}</h2>
      <p class="mt-2 text-ink-soft">{restaurant.openingHours.display.en}</p>

      <a
        href={restaurant.mapLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex min-h-[44px] items-center justify-center rounded-md bg-ink px-6 py-3 font-semibold text-cream-white hover:bg-ink-soft"
      >
        {strings.cta.viewOnMap}
      </a>
    </div>

    <MapEmbed locale={locale} />
  </div>
</Layout>
