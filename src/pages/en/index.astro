---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import { routes, t } from '../../data/i18n';
import { restaurant } from '../../data/restaurant';
import { withBase } from '../../utils/paths';
import DiamondIcon from '../../components/DiamondIcon.astro';
import StarRating from '../../components/StarRating.astro';
import logoWhite from '../../assets/images/logo-header-white.png';
import jamonImg from '../../assets/images/pro-jamon.jpg';
import platoImg from '../../assets/images/pro-plato-tapa.jpg';
import vinosImg from '../../assets/images/pro-vinos.jpg';
import ambienteImg from '../../assets/images/pro-interior-guitarra.jpg';
import mesaLargaImg from '../../assets/images/pro-mesa-larga.jpg';
import servicioImg from '../../assets/images/pro-servicio.jpg';

const locale = 'en' as const;
const strings = t(locale);

// Descriptions are a first draft to be refined with the client.
const highlights = [
  {
    title: 'Top-quality Extremaduran produce.',
    text: 'Hand-carved acorn-fed Iberian ham and cured meats, sliced to order.',
    img: jamonImg,
  },
  {
    title: 'Traditional cooking with a touch of innovation.',
    text: 'Time-honoured recipes with modern touches that surprise in every bite.',
    img: platoImg,
  },
  {
    title: 'A wine cellar of Extremaduran and Andalusian wines.',
    text: 'A curated selection to pair with every dish on the menu.',
    img: vinosImg,
  },
  {
    title: 'A wonderful, family-friendly atmosphere.',
    text: 'A warm, well-kept space designed to make you feel at home.',
    img: ambienteImg,
  },
  {
    title: 'Perfect for gatherings and private events.',
    text: 'Tables for groups and special occasions, with personal attention.',
    img: mesaLargaImg,
  },
  {
    title: 'Warm, personal service.',
    text: 'A team that knows you by name from your very first visit.',
    img: servicioImg,
  },
];
---

<Layout
  locale={locale}
  routeKey="home"
  isHome
  title="La Bacalona Sevilla"
  description="La Bacalona: an Extremaduran-Andalusian tavern built on seasonal produce, acorn-fed Iberian cured meats, and a menu made for sharing. Book a table in Seville."
>
  <section class="bg-espresso text-cream-white">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 md:py-28">
      <h1>
        <Image src={logoWhite} alt={restaurant.name} width={480} height={56} class="mx-auto h-auto w-full max-w-md" />
      </h1>
      <div class="mt-9 flex justify-center">
        <ReservationCta locale={locale} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {highlights.map((item) => (
        <li class="group overflow-hidden rounded-lg border border-ink/10 bg-cream-white shadow-sm transition-shadow hover:shadow-lg">
          <div class="overflow-hidden">
            <Image
              src={item.img}
              alt=""
              width={480}
              height={340}
              class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          <div class="p-5">
            <p class="font-semibold text-ink">{item.title}</p>
            <p class="mt-1.5 text-sm text-ink-soft">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={withBase(routes.menu[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-olive px-6 py-3 font-semibold text-cream-white shadow-sm hover:bg-olive-dark">
        {strings.cta.seeMenu}
      </a>
      <a href={withBase(routes.wines[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-ink/30 px-6 py-3 font-semibold text-ink hover:bg-ink hover:text-cream-white">
        {strings.cta.seeWines}
      </a>
    </div>
  </section>

  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <DiamondIcon class="mx-auto mb-4 block h-3.5 w-3.5 text-olive" />
      <h2 class="font-display text-4xl text-ink">In the heart of Seville</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-soft">
        You'll find us on Calle Amador de los Ríos, in the heart of Seville. A place where good taste, Iberian
        produce, creativity, and honest cooking take centre stage. Plus a spacious, family-friendly atmosphere
        that invites you to enjoy La Bacalona at any time of day.
      </p>
      <a href={withBase(routes.about[locale])} class="mt-6 inline-block font-semibold text-olive-dark underline-offset-4 hover:underline">
        Read our story →
      </a>
      <div class="mt-6 inline-flex items-center gap-2 text-ink-soft">
        <StarRating value={restaurant.googleRating.value} emptyClass="text-ink/15" filledClass="text-olive-dark" />
        <span class="font-semibold text-ink">{restaurant.googleRating.value}</span>
        <span>· {restaurant.googleRating.count} Google reviews</span>
      </div>
    </div>
  </section>
</Layout>
