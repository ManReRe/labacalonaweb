---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import { routes, t } from '../../data/i18n';
import { restaurant } from '../../data/restaurant';
import { withBase } from '../../utils/paths';
import DiamondIcon from '../../components/DiamondIcon.astro';
import StarRating from '../../components/StarRating.astro';
import interiorImg from '../../assets/images/interior-1.jpg';
import huevosImg from '../../assets/images/dish-huevos-fritas.jpg';
import boqueronesImg from '../../assets/images/dish-boquerones.jpg';
import tacoImg from '../../assets/images/dish-taco.jpg';

const locale = 'en' as const;
const strings = t(locale);

// Placeholder photos, repeated — real dedicated shots come later (site not public yet).
const highlights = [
  { text: 'Top-quality Extremaduran produce.', img: huevosImg },
  { text: 'Traditional cooking with a touch of innovation.', img: tacoImg },
  { text: 'A wine cellar of Extremaduran and Andalusian wines.', img: boqueronesImg },
  { text: 'A wonderful, family-friendly atmosphere.', img: interiorImg },
  { text: 'Perfect for gatherings and private events.', img: interiorImg },
  { text: 'Warm, personal service.', img: huevosImg },
];
---

<Layout
  locale={locale}
  routeKey="home"
  isHome
  title="La Bacalona Sevilla"
  description="La Bacalona: an Extremaduran-Andalusian tavern built on seasonal produce, acorn-fed Iberian cured meats, and a menu made for sharing. Book your table in central Seville."
>
  <section class="relative overflow-hidden bg-espresso text-cream-white">
    <div class="bg-diamond-texture pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-28">
      <div>
        <p class="flex items-center gap-2 font-semibold uppercase tracking-[0.2em] text-sand">
          <DiamondIcon class="h-3.5 w-3.5 text-olive" />
          Seville, city centre
        </p>
        <h1 class="mt-3 font-display text-6xl leading-[0.95] sm:text-7xl">
          {restaurant.name}
        </h1>
        <p class="mt-5 text-xl text-cream-white/90">{restaurant.tagline.en}</p>
        <p class="mt-3 max-w-md text-cream-white/70">{restaurant.shortDescription.en}</p>
        <a
          href={restaurant.mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-cream-white/90 hover:underline"
        >
          <StarRating value={restaurant.googleRating.value} emptyClass="text-cream-white/25" filledClass="text-olive" />
          <span class="font-semibold">{restaurant.googleRating.value}</span>
          <span class="text-cream-white/60">· {restaurant.googleRating.count} Google reviews</span>
        </a>
        <div class="mt-9">
          <ReservationCta locale={locale} />
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-3 -z-10 hidden rotate-1 rounded-lg border border-cream-white/20 sm:block"></div>
        <div class="aspect-square overflow-hidden rounded-lg shadow-2xl ring-1 ring-cream-white/10">
          <Image
            src={interiorImg}
            alt="Dining room interior at La Bacalona in Seville"
            width={640}
            height={640}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="text-center">
      <p class="font-semibold uppercase tracking-[0.2em] text-olive-dark">What sets us apart</p>
      <h2 class="mt-2 font-display text-4xl text-ink">What defines us</h2>
    </div>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {highlights.map((item) => (
        <li class="overflow-hidden rounded-lg border border-ink/10 bg-cream-white shadow-sm">
          <Image src={item.img} alt="" width={480} height={320} class="h-40 w-full object-cover" />
          <p class="flex items-start gap-2 p-4">
            <DiamondIcon class="mt-1 h-3 w-3 shrink-0 text-olive" />
            <span class="font-medium text-ink">{item.text}</span>
          </p>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={withBase(routes.menu[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-ink px-6 py-3 font-semibold text-cream-white shadow-sm hover:bg-ink-soft">
        {strings.cta.seeMenu}
      </a>
      <a href={withBase(routes.wines[locale])} class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-ink/30 px-6 py-3 font-semibold text-ink hover:bg-ink hover:text-cream-white">
        {strings.cta.seeWines}
      </a>
    </div>
  </section>

  <section class="bg-sand/50 py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <DiamondIcon class="mx-auto mb-4 block h-3.5 w-3.5 text-olive" />
      <h2 class="font-display text-4xl text-ink">In the heart of Seville</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-soft">
        You'll find us on Calle Amador de los Ríos, in the heart of Seville. A place where good taste, Iberian
        produce, creativity, and honest cooking take centre stage. Plus a spacious, family-friendly atmosphere
        that invites you to enjoy La Bacalona at any time of day.
      </p>
      <a href={withBase(routes.about[locale])} class="mt-6 inline-block font-semibold text-olive-dark underline-offset-4 hover:underline">
        Read our story →
      </a>
    </div>
  </section>
</Layout>
