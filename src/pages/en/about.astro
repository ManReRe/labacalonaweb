---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import interiorImg from '../../assets/images/pro-decor-panes.jpg';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  routeKey="about"
  title="About us | La Bacalona - Restaurant in Seville"
  description="Meet La Bacalona: an Extremaduran tavern since 2022 in central Seville, with produce from Llerena, Fregenal, and a good wine list."
>
  <PageHero eyebrow="About us" title="Our story" />

  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 md:items-center">
    <div class="space-y-5 text-ink-soft">
      <p>
        La Bacalona opened in 2022 as a tavern on Calle Amador de los Ríos, right in the centre of Seville. We
        bring back the spirit of Extremadura's taverns — cured meats, cheeses, and acorn-fed meats — and serve
        it with the warmth of a neighbourhood tavern.
      </p>
      <p>
        Our kitchen is run by a team of cooking professionals who take care with the product: cured meats from
        Llerena, acorn-fed Iberian meats from Fregenal de la Sierra, cheeses from several parts of Extremadura,
        Petaca Chico tuna, Torta del Casar, and Extremaduran patatera sausage.
      </p>
      <p>
        We believe in the shared table: portions made for tasting a bit of everything, dishes of our own like
        the flamenquín or the cachopazo Bacalona, and plenty of room in the dining room and terrace for groups
        of up to 150. We have an accessible restroom for visitors with reduced mobility.
      </p>
    </div>
    <div class="aspect-square overflow-hidden rounded-lg shadow-lg">
      <Image
        src={interiorImg}
        alt="Dining room at La Bacalona in Seville"
        width={640}
        height={640}
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <div class="mx-auto flex max-w-4xl justify-center px-4 pb-16 sm:px-6">
    <ReservationCta locale={locale} />
  </div>
</Layout>
