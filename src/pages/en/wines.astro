---
import Layout from '../../layouts/Layout.astro';
import WineList from '../../components/WineList.astro';
import AllergenLegend from '../../components/AllergenLegend.astro';
import PageHero from '../../components/PageHero.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import { wineSections } from '../../data/wines';
import { routes } from '../../data/i18n';
import { withBase } from '../../utils/paths';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  routeKey="wines"
  title="Wines | La Bacalona - Restaurant in Seville"
  description="La Bacalona's wine list: Palacio Quemado (D.O. Ribera del Guadiana), plus Ribera del Duero, Rioja, D.O. Rueda whites, and fortified wines."
>
  <PageHero
    eyebrow="Wines"
    title="Our wine list"
    subtitle="Our house wine is Palacio Quemado, from Alange (Badajoz), D.O. Ribera del Guadiana. We also have reds from Ribera del Duero and Rioja, D.O. Rueda whites, and fortified wines, by the glass or bottle."
  >
    <ReservationCta locale={locale} />
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <WineList locale={locale} sections={wineSections} />

    <AllergenLegend locale={locale} />

    <p class="mt-6 text-center text-ink-soft">
      Want to see what to eat first? Here's{' '}
      <a href={withBase(routes.menu[locale])} class="font-semibold text-olive-dark underline-offset-4 hover:underline">
        our menu
      </a>.
    </p>

    <div class="mt-6 flex justify-center">
      <ReservationCta locale={locale} />
    </div>
  </div>
</Layout>
