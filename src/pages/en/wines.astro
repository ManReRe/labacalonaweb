---
import Layout from '../../layouts/Layout.astro';
import WineList from '../../components/WineList.astro';
import AllergenLegend from '../../components/AllergenLegend.astro';
import PageHero from '../../components/PageHero.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import { wineSections } from '../../data/wines';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  routeKey="wines"
  title="Wines | La Bacalona — Restaurant in Seville"
  description="La Bacalona's wine list: reds from Ribera del Duero, Rioja, and Ribera del Guadiana, whites, fortified wines, and sparkling, by glass or bottle."
>
  <PageHero
    eyebrow="Wines"
    title="Our wine list"
    subtitle="A selection chosen to pair with every dish, featuring Spanish designations of origin."
  />

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <WineList locale={locale} sections={wineSections} />

    <AllergenLegend locale={locale} />

    <div class="mt-10">
      <ReservationCta locale={locale} />
    </div>
  </div>
</Layout>
