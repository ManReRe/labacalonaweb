---
import Layout from '../../layouts/Layout.astro';
import WineList from '../../components/WineList.astro';
import AllergenLegend from '../../components/AllergenLegend.astro';
import PageHero from '../../components/PageHero.astro';
import ReservationCta from '../../components/ReservationCta.astro';
import { wineSections } from '../../data/wines';

const locale = 'en' as const;
---

<Layout
  locale={locale}
  routeKey="wines"
  title="Wines | La Bacalona - Restaurant in Seville"
  description="La Bacalona's wine list: Palacio Quemado (Alange) is our house bodega, plus reds from Ribera del Duero and Rioja, whites, and fortified wines."
>
  <PageHero
    eyebrow="Wines"
    title="Our wine list"
    subtitle="Our house bodega is Palacio Quemado, in Alange (Badajoz). You'll find it by the glass or bottle, alongside reds from Ribera del Duero and Rioja, whites, and fortified wines."
  >
    <ReservationCta locale={locale} />
  </PageHero>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <WineList locale={locale} sections={wineSections} />

    <AllergenLegend locale={locale} />

    <div class="mt-10 flex justify-center">
      <ReservationCta locale={locale} />
    </div>
  </div>
</Layout>
