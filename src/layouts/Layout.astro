---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { restaurant } from '../data/restaurant';
import { routes, t, type Locale, type RouteKey } from '../data/i18n';
import { withBase } from '../utils/paths';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  /** Set true only on the two homepages — drives the one-time client redirect. */
  isHome?: boolean;
  ogImage?: string;
}

const { locale, routeKey, title, description, isHome = false, ogImage } = Astro.props;
const strings = t(locale);

const canonicalPath = routes[routeKey][locale];
const canonicalURL = new URL(canonicalPath, Astro.site);
const esURL = new URL(routes[routeKey].es, Astro.site);
const enURL = new URL(routes[routeKey].en, Astro.site);
const defaultOgImage = new URL('/og-default.jpg', Astro.site).toString();
const homeEs = withBase(routes.home.es);
const homeEn = withBase(routes.home.en);

const restaurantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.name,
  image: defaultOgImage,
  url: Astro.site?.toString(),
  telephone: `+34${restaurant.phone}`,
  priceRange: restaurant.priceRange,
  servesCuisine: restaurant.cuisineTypes,
  address: {
    '@type': 'PostalAddress',
    streetAddress: restaurant.address.streetAddress,
    postalCode: restaurant.address.postalCode,
    addressLocality: restaurant.address.addressLocality,
    addressRegion: restaurant.address.addressRegion,
    addressCountry: restaurant.address.addressCountry,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: restaurant.openingHours.days,
    opens: restaurant.openingHours.opens,
    closes: restaurant.openingHours.closes,
  },
  sameAs: [restaurant.instagram],
  acceptsReservations: 'True',
  reservations: restaurant.coverManagerUrl,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: restaurant.googleRating.value,
    reviewCount: restaurant.googleRating.count,
  },
} as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {import.meta.env.PUBLIC_IS_PREVIEW_DEPLOY === 'true' && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage ?? defaultOgImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(restaurantJsonLd)} is:inline />

    {isHome && (
      <script define:vars={{ homeEs, homeEn }} is:inline>
        // One-time client-side language redirect on first visit only (CLAUDE.md 3.1).
        // Never a server/edge redirect — crawlers always see the unprefixed ES page.
        (function () {
          try {
            if (localStorage.getItem('labacalona-locale-redirected')) return;
            localStorage.setItem('labacalona-locale-redirected', '1');
            const path = window.location.pathname;
            const isEnglishPage = path === homeEn || path.startsWith(homeEn + '/');
            const prefersEnglish = navigator.language?.toLowerCase().startsWith('en');
            if (prefersEnglish && !isEnglishPage) {
              window.location.replace(homeEn);
            } else if (!prefersEnglish && isEnglishPage) {
              window.location.replace(homeEs);
            }
          } catch (_e) {
            // localStorage unavailable (privacy mode, etc.) — skip redirect silently.
          }
        })();
      </script>
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:text-paper focus:px-4 focus:py-2 focus:rounded"
    >
      {strings.skipToContent}
    </a>
    <Header locale={locale} routeKey={routeKey} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      // Fade/slide elements up once as they enter the viewport. Only ever
      // touches opacity/transform (compositor-only) on the element itself —
      // never position, size, or a container — so it can't misalign layout
      // on scroll/resize the way sticky/pinned scroll effects can.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        const els = document.querySelectorAll('[data-reveal]');
        els.forEach(function (el, i) {
          el.classList.add('reveal-init');
          el.style.transitionDelay = Math.min(i % 6, 5) * 80 + 'ms';
        });
        const io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
