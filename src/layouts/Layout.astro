---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { restaurant } from '../data/restaurant';
import { routes, t, type Locale, type RouteKey } from '../data/i18n';
import { withBase } from '../utils/paths';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  ogImage?: string;
}

const { locale, routeKey, title, description, ogImage } = Astro.props;
const strings = t(locale);

const canonicalPath = routes[routeKey][locale];
const canonicalURL = new URL(canonicalPath, Astro.site);
const esURL = new URL(routes[routeKey].es, Astro.site);
const enURL = new URL(routes[routeKey].en, Astro.site);
const defaultOgImage = new URL('/og-default.jpg', Astro.site).toString();
const resolvedOgImage = ogImage ?? defaultOgImage;

// Home > [current page] — every other page gets one; the homepage doesn't
// link to itself. Labels borrow from nav where the page has a nav entry,
// and from the footer's legal-links labels otherwise (legalNotice/privacy/
// cookies aren't in the main nav).
const breadcrumbLabel: Record<RouteKey, string> = {
  home: strings.nav.home,
  about: strings.nav.about,
  menu: strings.nav.menu,
  wines: strings.nav.wines,
  reservations: strings.nav.reservations,
  contact: strings.nav.contact,
  legalNotice: strings.footer.legalNotice,
  privacy: strings.footer.privacy,
  cookies: strings.footer.cookies,
};
const breadcrumbJsonLd =
  routeKey === 'home'
    ? null
    : ({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: strings.nav.home,
            item: new URL(routes.home[locale], Astro.site).toString(),
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: breadcrumbLabel[routeKey],
            item: canonicalURL.toString(),
          },
        ],
      } as const);

const restaurantJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.name,
  image: defaultOgImage,
  url: Astro.site?.toString(),
  telephone: `+34${restaurant.phone}`,
  priceRange: restaurant.priceRange,
  servesCuisine: restaurant.cuisineTypes,
  address: {
    '@type': 'PostalAddress',
    streetAddress: restaurant.address.streetAddress,
    postalCode: restaurant.address.postalCode,
    addressLocality: restaurant.address.addressLocality,
    addressRegion: restaurant.address.addressRegion,
    addressCountry: restaurant.address.addressCountry,
  },
  // One spec per group of days sharing the same hours — hours can (and do)
  // vary by day per the Google Business Profile listing, which is always
  // the source of truth (see scripts/sync-opening-hours.mjs).
  openingHoursSpecification: restaurant.openingHours.groups.map((group) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: group.days,
    opens: group.opens,
    closes: group.closes,
  })),
  sameAs: [restaurant.instagram],
  acceptsReservations: 'True',
  reservations: restaurant.coverManagerUrl,
  // Points at the real Menu/MenuSection/MenuItem graph built in
  // buildMenuJsonLd (src/data/menu.ts) and emitted on /menu itself — this is
  // just the cross-reference from the Restaurant entity to it.
  hasMenu: new URL(routes.menu[locale], Astro.site).toString(),
  hasMap: restaurant.mapLink,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: restaurant.googleRating.value,
    reviewCount: restaurant.googleRating.count,
  },
} as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Google Search prefers ICO/PNG over SVG for the little icon shown next
      to a result's URL (SVG-only support there is limited) — this trio
      matches Google's own recommended favicon setup. The .ico is
      multi-resolution (16/32/48px); browsers that support SVG favicons use
      the crisper one instead.
    */}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={restaurant.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <script type="application/ld+json" set:html={JSON.stringify(restaurantJsonLd)} is:inline />
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:text-paper focus:px-4 focus:py-2 focus:rounded"
    >
      {strings.skipToContent}
    </a>
    <Header locale={locale} routeKey={routeKey} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      // Fade/slide elements up once as they enter the viewport. Only ever
      // touches opacity/transform (compositor-only) on the element itself —
      // never position, size, or a container — so it can't misalign layout
      // on scroll/resize the way sticky/pinned scroll effects can.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        const els = document.querySelectorAll('[data-reveal]');
        els.forEach(function (el, i) {
          el.classList.add('reveal-init');
          el.style.transitionDelay = Math.min(i % 6, 5) * 80 + 'ms';
        });
        const io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>

    {/*
      GoatCounter — cookieless page-view analytics (no localStorage, no
      fingerprinting; IP is hashed with a salt that rotates every 8h and
      never stored — see privacidad.astro / privacy-policy.astro). Added by
      explicit client request (2026-10-09) to see traffic beyond what
      Search Console reports (direct visits, Instagram, etc.), without
      reopening the "no analytics by default" stance in CLAUDE.md 3.2 for
      anything heavier.
    */}
    <script
      data-goatcounter="https://labacalona.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
      is:inline></script>
  </body>
</html>
